# Plantilla del .env del backend. Copiar como .env y rellenar.
# El .env real NO se sube al repositorio (está en .gitignore).

# ---------------------------------------------------------------- ENTORNO
# 'produccion' en el servidor, cualquier otra cosa (o vacío) en local.
# En produccion: la cookie de sesión pasa a SameSite=None + Secure (necesario
# porque el frontend está en otro dominio) y se desactiva /docs.
ENTORNO=produccion

# ------------------------------------------------------------ BASE DE DATOS
DB_USER=
DB_PASS=
DB_HOST=localhost:3306
DB_NAME=amancio_2026

# Conexiones a la base y peticiones simultáneas. Los valores por defecto (20+20
# conexiones, 40 peticiones a la vez) van sobrados para el colegio entero.
# El tope real lo pone el servidor de base de datos: pregunta el
# `max_user_connections` del plan y deja que DB_POOL_SIZE + DB_MAX_OVERFLOW
# quepan por debajo. En un hosting compartido suele andar entre 25 y 50.
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=10
# HILOS_PETICIONES=40

# -------------------------------------------------------------- SEGURIDAD
# Cadena larga y aleatoria. Si cambia, se invalidan todas las sesiones abiertas.
# Generar con:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------- CORS
# Dominios del frontend, separados por comas y CON https en producción.
# Sin barra final. Si esto no coincide con el dominio real, el navegador
# bloquea todas las llamadas a la API.
ALLOWED_ORIGINS=https://www.amanciovarona.edu.pe

# ---------------------------------------------------------------- CHATBOT
PINECONE_API_KEY=
GOOGLE_API_KEY=
INDEX_NAME=

# OCR de PDFs escaneados (opcional). Si faltan, el chatbot funciona igual:
# solo deja de leer PDFs que son imágenes, y lo avisa al arrancar.
# TESSDATA_PREFIX=
# POPPLER_PATH=

# ------------------------------------------------------------------ CORREO
SMTP_HOST=mail.amanciovarona.com
SMTP_PORT=465
SMTP_USER=notificaciones@amanciovarona.com
SMTP_PASSWORD=
SMTP_FROM_NAME=Colegio Amancio Varona
SMTP_REPLY_TO=
# Envío por lotes: cuántos correos por conexión y cuánto esperar entre lotes.
SMTP_MAX_POR_CONEXION=50
SMTP_PAUSA_SEGUNDOS=2

# -------------------------------------------------------------- NOTIFICACIONES
# Estados de asistencia que disparan aviso a la familia.
ASISTENCIA_ESTADOS_NOTIFICABLES=FALTA,TARDANZA

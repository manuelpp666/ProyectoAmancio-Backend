# =============================================================
#  Plantilla de variables de entorno del backend
#  Copiar como .env y rellenar. El .env real NO se sube a git.
# =============================================================

# --- Base de datos (MySQL) ---
DB_USER=root
DB_PASS=
DB_HOST=127.0.0.1
DB_NAME=nombre_de_la_base

# --- Chatbot (Pinecone + Google Gemini) ---
PINECONE_API_KEY=
GOOGLE_API_KEY=
INDEX_NAME=

# --- Seguridad / JWT ---
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# Orígenes del frontend separados por coma, SIN barra final.
# En producción: https://amanciovarona.com,https://www.amanciovarona.com
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================
#  ENVÍO DE CORREOS (SMTP)
# =============================================================
# Si SMTP_USER o SMTP_PASSWORD quedan vacíos, la app NO envía correos:
# lo registra en el log y sigue funcionando con normalidad.
#
# IMPORTANTE: escribir la contraseña sin espacios y sin comentarios
# al final de la línea.

# --- Opción A: cPanel (amanciovarona.com) ---
# El host exacto sale de cPanel > Cuentas de correo > "Conectar dispositivos".
# Usar el hostname del servidor, no mail.tudominio.com, para evitar
# errores de certificado SSL.
# SMTP_HOST=mail.amanciovarona.com
# SMTP_PORT=465
# SMTP_USER=notificaciones@amanciovarona.com
# SMTP_PASSWORD=

# --- Opción B: relay transaccional (recomendado en producción) ---
# Amazon SES, Brevo, Resend, etc. Soportan el mismo SMTP estándar,
# así que solo cambian estos cuatro valores.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Nombre visible del remitente
SMTP_FROM_NAME=Colegio Amancio Varona

# Buzon al que llegan las respuestas de los apoderados (opcional).
# Util si el colegio quiere que se pueda contestar a un correo real
# en vez del remitente automatico.
SMTP_REPLY_TO=

# --- Ritmo de los envíos masivos ---
# Mensajes por conexión antes de reciclarla y pausa entre mensajes.
# Bajar SMTP_MAX_POR_CONEXION y subir SMTP_PAUSA_SEGUNDOS si el
# proveedor corta la conexión a mitad de un lote.
SMTP_MAX_POR_CONEXION=50
SMTP_PAUSA_SEGUNDOS=0.5

# --- Notificaciones de asistencia ---
# Estados que generan correo al apoderado:
#   P = Presente, T = Tardanza, F = Falta, J = Justificado
# "P" se deja fuera a propósito: un correo diario de asistencia normal
# satura al padre y dispara las quejas de spam.
ASISTENCIA_ESTADOS_NOTIFICABLES=T,F,J
